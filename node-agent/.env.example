PORT=8787
# Use a unique high-entropy token; keep private and match NODE_AGENT_TOKEN in Hvm/.env
HVM_NODE_TOKEN=replace-with-a-long-random-token

# KVM creation requires a cloud-init-enabled base image already present on the node.
# Example: /var/lib/libvirt/images/ubuntu-24.04-server-cloudimg-amd64.img
HVM_KVM_IMAGE=
HVM_KVM_IMAGE_FORMAT=qcow2
HVM_KVM_STORAGE_DIR=/var/lib/libvirt/images
